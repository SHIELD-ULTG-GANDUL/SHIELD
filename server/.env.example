# Salin file ini ke .env dan isi nilainya, lalu:
#   export $(grep -v '^#' .env | xargs)
# sebelum menjalankan skrip apa pun di server/ (atau pasang python-dotenv,
# lihat server/settings.py -- opsional, tidak wajib).
#
# JANGAN commit file .env (isi sebenarnya) ke git — sudah masuk .gitignore.
#
# T1 (Tahap 1, Oktober 2026): semua skrip di server/ sekarang membaca
# konfigurasi lewat server/settings.py, BUKAN dari default hardcode di kode.
# Kalau env var wajib di bawah tidak diisi, skrip gagal start dengan pesan
# jelas (MissingSettingError) -- lihat settings.py.

# ── Database utama (shield_data — trafo_temperature, trafo_load) ──────────
# Dipakai: api.py, mqtt_subscriber.py, migrate_firestore_to_timescale.py (deprecated)
DATABASE_URL=postgresql://shield:ganti-password-ini@localhost:5432/shield_data

# ── Broker MQTT lokal (Mosquitto di server yang sama) ──────────────────────
# Dipakai: mqtt_subscriber.py. Broker saat ini TIDAK memakai autentikasi
# (lihat rekomendasi keamanan T1 soal menambah ACL) -- kosongkan
# MQTT_LOCAL_USER/PASS selama itu belum ada.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=shield/trafo/#
MQTT_LOCAL_USER=
MQTT_LOCAL_PASS=

# ── Broker MQTT cloud (HiveMQ) — HANYA dipakai mqtt_ingester.py ───────────
# mqtt_ingester.py DEPRECATED (service shield-ingester sudah dinonaktifkan,
# lihat README.md). Kredensial di bawah TIDAK ADA default-nya lagi di kode —
# kalau skrip ini pernah dijalankan lagi, harus diisi eksplisit.
# PENTING: password HiveMQ yang lama (dipakai sebelum Tahap 1) sempat
# ter-hardcode di riwayat git repo ini — rotasi password di HiveMQ dashboard
# direkomendasikan terlepas dari apa yang diisi di sini (lihat laporan
# risiko T1).
HIVEMQ_BROKER=ganti-dengan-host-hivemq-anda.s1.eu.hivemq.cloud
HIVEMQ_PORT=8884
HIVEMQ_USER=ganti-user-hivemq
HIVEMQ_PASS=ganti-password-hivemq

# ── Lokasi GI Gandul (suhu ambient, Open-Meteo) ────────────────────────────
# HARUS sama persis dengan GANDUL_WEATHER_POINT di index.html/Shield.html —
# belum ada sinkronisasi otomatis antara keduanya.
GANDUL_LATITUDE=-6.346667
GANDUL_LONGITUDE=106.7875

# ── Proxy keluar opsional ───────────────────────────────────────────────────
# Audit Fase 0 menemukan server ini di belakang proxy yang meng-intercept TLS
# (curl ke api.open-meteo.com gagal verifikasi sertifikat). JANGAN
# menonaktifkan verifikasi SSL di kode -- kalau IT memasang root CA korporat
# ke trust store server, isi path CA bundle-nya di sini.
OUTBOUND_HTTPS_PROXY=
OUTBOUND_CA_BUNDLE=

# ── Interval worker (detik) ─────────────────────────────────────────────────
# TODO(verifikasi): AMBIENT_WORKER_INTERVAL_SECONDS disalin dari
# GANDUL_WEATHER_POINT.refreshMs di index.html (10 menit). Worker ambient
# (T3) dan worker LNTAI (T4) belum dibuat di tahap ini.
WRITE_INTERVAL_SECONDS=60
AMBIENT_WORKER_INTERVAL_SECONDS=600
LNTAI_WORKER_INTERVAL_SECONDS=60

# ── API baca-saja (api.py) ──────────────────────────────────────────────────
# Opsional: kalau diisi, endpoint API wajib header X-API-Key yang cocok.
# Generate contoh: openssl rand -hex 32
# CATATAN KEAMANAN (lihat laporan risiko T1): nilai ini saat ini di-hardcode
# di index.html yang di-serve publik lewat GitHub Pages. Karena API hanya
# bisa dijangkau dari intranet, risikonya terbatas, tapi API key yang
# "terbuka di View Source" pada dasarnya tidak melindungi apa-apa lagi dari
# siapa pun yang sudah punya akses intranet.
API_KEY=

# Origin yang boleh memanggil API dari browser (pisahkan koma kalau lebih dari satu)
ALLOWED_ORIGINS=https://shield-ultg-gandul.github.io
