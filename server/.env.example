# Salin file ini ke .env dan isi nilainya, lalu:
#   export $(grep -v '^#' .env | xargs)
# sebelum menjalankan mqtt_ingester.py / uvicorn api:app
#
# JANGAN commit file .env (isi sebenarnya) ke git — sudah masuk .gitignore.

# Sama seperti broker yang dipakai Shield.html
MQTT_BROKER=d36cf3116e2a4d93bf531ebf8a1ffa38.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=webshield
MQTT_PASS=webShield123

# Buat lewat: sudo -u postgres psql -c "CREATE USER shield WITH PASSWORD '...';"
DATABASE_URL=postgresql://shield:CHANGE_ME@localhost:5432/shield

# Berapa detik minimal antar baris tersimpan per trafo (throttle penulisan)
WRITE_INTERVAL_SECONDS=60

# Opsional: kalau diisi, endpoint API wajib header X-API-Key yang cocok.
# Generate contoh: openssl rand -hex 32
API_KEY=

# Origin yang boleh memanggil API dari browser (pisahkan koma kalau lebih dari satu)
ALLOWED_ORIGINS=https://shield-ultg-gandul.github.io
