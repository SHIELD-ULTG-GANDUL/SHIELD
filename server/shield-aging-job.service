[Unit]
Description=SHIELD thermal aging factor job (Stage 2 Part C) — one-shot, run by shield-aging-job.timer
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=shield
WorkingDirectory=/opt/shield/server
EnvironmentFile=/opt/shield/server/.env
ExecStart=/opt/shield/server/venv/bin/python3 aging_job.py
